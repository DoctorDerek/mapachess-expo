{
  "name": "@mapachess/stockfish-native",
  "version": "0.0.0",
  "private": true,
  "description": "Mapachess native Stockfish engine bridge",
  "homepage": "https://mapachess.com",
  "author": "Dr. Derek Austin",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    "./build-identity": {
      "types": "./src/nativeBuildIdentity.ts",
      "default": "./dist/nativeBuildIdentity.js"
    },
    "./provision": {
      "types": "./src/provision.ts",
      "default": "./dist/provision.js"
    },
    "./native-module": {
      "types": "./src/NativeMapachessStockfish.ts",
      "react-native": "./src/NativeMapachessStockfish.ts",
      "default": "./src/NativeMapachessStockfish.ts"
    },
    "./session": {
      "types": "./src/nativeStockfishSession.ts",
      "react-native": "./src/nativeStockfishSession.ts",
      "default": "./dist/nativeStockfishSession.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "provision": "pnpm run build && node dist/provisionCli.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --project tsconfig.json"
  },
  "codegenConfig": {
    "name": "MapachessStockfishSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "outputDir": {
      "android": "android/generated",
      "ios": "ios/generated"
    },
    "android": {
      "javaPackageName": "com.mapachess.stockfish"
    },
    "includesGeneratedCode": true
  },
  "dependencies": {
    "@mapachess/stockfish": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/react": "^19",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "typescript": "^6",
    "vitest": "^4"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  }
}
