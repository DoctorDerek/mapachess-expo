{
  "name": "@mapachess/stockfish",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    "./engine-session": {
      "types": "./src/engineSession.ts",
      "default": "./dist/engineSession.js"
    },
    "./engine-validation": {
      "types": "./src/engineValidation.ts",
      "default": "./dist/engineValidation.js"
    },
    "./build-identity": {
      "types": "./src/buildIdentity.ts",
      "default": "./dist/buildIdentity.js"
    },
    "./provision": {
      "types": "./src/provision.ts",
      "default": "./dist/provision.js"
    },
    "./uci-process-adapter": {
      "types": "./src/uciProcessAdapter.ts",
      "default": "./dist/uciProcessAdapter.js"
    },
    "./uci-session": {
      "types": "./src/uciSession.ts",
      "default": "./dist/uciSession.js"
    },
    "./web-runtime-identity": {
      "types": "./src/webRuntimeIdentity.ts",
      "default": "./dist/webRuntimeIdentity.js"
    },
    "./web-runtime-provision": {
      "types": "./src/webRuntimeProvision.ts",
      "default": "./dist/webRuntimeProvision.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "provision": "pnpm run build && node dist/provisionCli.js ../..",
    "provision:web": "pnpm run build && node dist/webRuntimeProvisionCli.js ../..",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --project tsconfig.json"
  }
}
