{
  "name": "@mapachess/stockfish",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    "./build-identity": {
      "types": "./src/buildIdentity.ts",
      "default": "./dist/buildIdentity.js"
    },
    "./provision": {
      "types": "./src/provision.ts",
      "default": "./dist/provision.js"
    },
    "./uci-process-adapter": {
      "types": "./src/uciProcessAdapter.ts",
      "default": "./dist/uciProcessAdapter.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "provision": "pnpm run build && node dist/provisionCli.js ../..",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --project tsconfig.json"
  }
}
