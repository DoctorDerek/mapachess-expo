{
  "name": "@mapachess/profile",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    "./player-data": {
      "types": "./src/playerData.ts",
      "default": "./dist/playerData.js"
    },
    "./player-data-codec": {
      "types": "./src/playerDataCodec.ts",
      "default": "./dist/playerDataCodec.js"
    },
    "./portable-backup": {
      "types": "./src/portableBackup.ts",
      "default": "./dist/portableBackup.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@mapachess/match": "workspace:*"
  }
}
