{
  "name": "@mapachess/application-ui",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    "./match-setup": {
      "types": "./src/MatchSetup.tsx",
      "default": "./dist/MatchSetup.js"
    },
    "./match-setup-editor": {
      "types": "./src/MatchSetupEditor.tsx",
      "default": "./dist/MatchSetupEditor.js"
    },
    "./setup-elements": {
      "types": "./src/setupElements.ts",
      "default": "./dist/setupElements.js"
    },
    "./setup-choices": {
      "types": "./src/SetupChoices.tsx",
      "default": "./dist/SetupChoices.js"
    },
    "./setup-animal-choices": {
      "types": "./src/SetupAnimalChoices.tsx",
      "default": "./dist/SetupAnimalChoices.js"
    },
    "./challenge-difficulty": {
      "types": "./src/ChallengeDifficulty.tsx",
      "default": "./dist/ChallengeDifficulty.js"
    },
    "./profile-recovery": {
      "types": "./src/ProfileRecovery.tsx",
      "default": "./dist/ProfileRecovery.js"
    },
    "./recovery-elements": {
      "types": "./src/recoveryElements.ts",
      "default": "./dist/recoveryElements.js"
    },
    "./home": {
      "types": "./src/Home.tsx",
      "default": "./dist/Home.js"
    },
    "./profile-card": {
      "types": "./src/ProfileCard.tsx",
      "default": "./dist/ProfileCard.js"
    },
    "./home-elements": {
      "types": "./src/homeElements.ts",
      "default": "./dist/homeElements.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@mapachess/gameplay": "workspace:*",
    "@mapachess/localization": "workspace:*",
    "@mapachess/match": "workspace:*",
    "@mapachess/profile": "workspace:*",
    "@xstate/react": "^6",
    "classix": "^2",
    "xstate": "^5"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@types/react": "^19"
  }
}
