{
  "name": "@mapachess/web",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "assets:prepare": "node --import jiti/register ../../scripts/decrypt-assets.ts",
    "build": "pnpm --workspace-root stockfish:provision:web && next build",
    "dev": "next dev",
    "prebuild": "pnpm run assets:prepare",
    "predev": "pnpm run assets:prepare",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@mapachess/evaluation": "workspace:*",
    "@mapachess/hints": "workspace:*",
    "@mapachess/match": "workspace:*",
    "@mapachess/profile": "workspace:*",
    "@mapachess/stockfish": "workspace:*",
    "@xstate/react": "^6",
    "motion": "^13",
    "next": "^16",
    "react": "^19",
    "react-dom": "^19",
    "xstate": "^5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "fake-indexeddb": "^6",
    "postcss": "^8",
    "tailwindcss": "^4",
    "vite": "^8"
  },
  "engines": {
    "node": "^24"
  }
}
