{
  "name": "@mapachess/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "build": "expo export --platform android --output-dir dist/android",
    "dev": "expo start --dev-client",
    "doctor": "expo-doctor",
    "eas-build-post-install": "pnpm --filter @mapachess/stockfish-native provision",
    "native:prebuild": "expo prebuild --clean",
    "start": "expo start --dev-client",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@mapachess/stockfish": "workspace:*",
    "@mapachess/stockfish-native": "workspace:*",
    "expo": "~57.0.18",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.16",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-worklets": "0.10.1",
    "uniwind": "^1"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@types/react": "^19",
    "expo-doctor": "^1",
    "tailwindcss": "^4",
    "typescript": "^6"
  },
  "engines": {
    "node": "^24"
  }
