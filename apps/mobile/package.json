{
  "name": "@mapachess/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "main": "expo-router/entry",
  "scripts": {
    "app:prepare": "pnpm --filter @mapachess/gameplay... --filter @mapachess/stockfish-native... build && pnpm run assets:prepare",
    "assets:prepare": "node --import jiti/register ../../scripts/prepareNativeAssets.ts",
    "preandroid": "pnpm run app:prepare",
    "prebuild": "pnpm run app:prepare",
    "predev": "pnpm run app:prepare",
    "prestart": "pnpm run app:prepare",
    "android": "expo run:android",
    "build": "expo export --platform android --output-dir dist/android",
    "dev": "expo start --dev-client",
    "doctor": "expo-doctor",
    "eas-build-post-install": "pnpm --filter @mapachess/stockfish-native provision && pnpm run app:prepare",
    "native:prebuild": "expo prebuild --clean",
    "start": "expo start --dev-client",
    "test:native": "pnpm run test:native:prepare && jest --runInBand",
    "test:native:coverage": "pnpm run test:native:prepare && jest --coverage --runInBand",
    "test:native:prepare": "pnpm run app:prepare",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@expo-google-fonts/nunito-sans": "^0.4.2",
    "@mapachess/evaluation": "workspace:*",
    "@mapachess/gameplay": "workspace:*",
    "@mapachess/hints": "workspace:*",
    "@mapachess/match": "workspace:*",
    "@mapachess/match-presentation": "workspace:*",
    "@mapachess/diagnostics": "workspace:*",
    "@mapachess/localization": "workspace:*",
    "@mapachess/profile": "workspace:*",
    "@mapachess/stockfish": "workspace:*",
    "@mapachess/stockfish-native": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rive-app/react-native": "^0.5.4",
    "classix": "^2",
    "expo": "~57.0.18",
    "expo-asset": "~57.0.15",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.16",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-linking": "~57.0.8",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.17",
    "expo-status-bar": "~57.0.1",
    "expo-sharing": "~57.0.16",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-worklets": "0.10.1",
    "uniwind": "^1",
    "upng-js": "^2",
    "xstate": "^5"
  },
  "devDependencies": {
    "@jest/globals": "^29",
    "@react-native/metro-config": "0.86.3",
    "@testing-library/react-native": "^14",
    "@types/jest": "^29",
    "@types/react": "^19",
    "@types/upng-js": "^2",
    "expo-doctor": "^1",
    "jest": "^29",
    "jest-expo": "~57.0.5",
    "tailwindcss": "^4",
    "test-renderer": "^1",
    "typescript": "^6"
  },
  "engines": {
    "node": "^24"
  }
}
