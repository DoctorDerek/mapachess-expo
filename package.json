{
  "name": "mapachess-expo",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "scripts": {
    "build": "turbo run build",
    "calibration:chicken": "pnpm --filter @mapachess/calibration... build && pnpm --filter @mapachess/calibration chicken",
    "calibration:smoke": "pnpm --filter @mapachess/calibration... build && pnpm --filter @mapachess/calibration smoke",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lighthouse": "node scripts/runTypeScript.mjs scripts/lighthouse/collectLighthouseReports.cli.ts",
    "lighthouse:prepare": "node scripts/runTypeScript.mjs scripts/lighthouse/prepareLighthouseReports.cli.ts",
    "lint": "eslint .",
    "mobile:android": "pnpm --filter @mapachess/mobile run android",
    "mobile:dev": "pnpm --filter @mapachess/mobile run dev",
    "mobile:doctor": "pnpm --filter @mapachess/mobile run doctor",
    "mobile:export": "pnpm --filter @mapachess/mobile run build",
    "mobile:prebuild": "pnpm --filter @mapachess/mobile run native:prebuild",
    "stockfish:provision": "pnpm --filter @mapachess/stockfish provision",
    "stockfish:provision:web": "pnpm --filter @mapachess/stockfish provision:web",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "playwright test",
    "test:e2e:stockfish:web": "pnpm stockfish:provision:web && playwright test --config playwright.stockfish.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:integration:stockfish": "turbo run test:integration:stockfish",
    "test:lighthouse": "vitest run --config vitest.lighthouse.config.ts",
    "test:xstate-diff": "vitest run --coverage --config vitest.xstate.config.ts",
    "typecheck": "turbo run typecheck",
    "xstate:diff": "node scripts/runTypeScript.mjs scripts/xstate-diff/xstateDiff.cli.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4",
    "@eslint/js": "^10",
    "@ianvs/prettier-plugin-sort-imports": "^4",
    "@playwright/test": "^1",
    "@types/node": "^26",
    "@vitest/coverage-v8": "^4",
    "chrome-launcher": "^1",
    "eslint": "^10",
    "eslint-config-flat-gitignore": "^2",
    "eslint-config-prettier": "^10",
    "eslint-plugin-only-warn": "^1",
    "jiti": "^2",
    "lighthouse": "^13",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2",
    "typescript": "^6",
    "vitest": "^4"
  }
}
